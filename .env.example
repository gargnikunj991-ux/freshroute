# FreshRoute Environment Configuration Template
PORT=8080

# PostgreSQL Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/freshroutedb
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver

# (Optional) H2 In-Memory Fallback:
# SPRING_DATASOURCE_URL=jdbc:h2:mem:freshroutedb;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
# SPRING_DATASOURCE_USERNAME=sa
# SPRING_DATASOURCE_PASSWORD=

# Deployment & Keep-Alive Configuration
RENDER_EXTERNAL_URL=
APP_BASE_URL=http://localhost:8080

# Security & CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Economic & Supply Chain Parameters
FRESHROUTE_SAFETY_BUFFER_HOURS=12.0
FRESHROUTE_HANDLING_COST_PER_KG=0.50
FRESHROUTE_DISPOSAL_PENALTY_PER_KG=3.00
FRESHROUTE_Q10_COEFFICIENT=2.2
