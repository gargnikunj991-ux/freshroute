# FreshRoute Environment Configuration Template
# Duplicate this file as .env for local overrides

# Server
PORT=8080

# Database Configuration (H2 in-memory default, easily swappable with PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:h2:mem:freshroutedb;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=

# Deployment & Keep-Alive Configuration
# Render sets RENDER_EXTERNAL_URL automatically (e.g. https://freshroute-backend.onrender.com)
RENDER_EXTERNAL_URL=
APP_BASE_URL=http://localhost:8080

# Security & CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Economic & Supply Chain Parameters
FRESHROUTE_SAFETY_BUFFER_HOURS=12.0
FRESHROUTE_HANDLING_COST_PER_KG=0.50
FRESHROUTE_DISPOSAL_PENALTY_PER_KG=3.00
FRESHROUTE_Q10_COEFFICIENT=2.2
